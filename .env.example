# ─────────────────────────────────────────────────────────────────
# HydroThermal Nexus-AI Environment Variable Configuration Example
# Copy to .env and adjust variables as required for local/prod runs
# ─────────────────────────────────────────────────────────────────

# API & Security Configuration
NEXUS_API_SECRET=NexusAPI_Internal_2026
NEXUS_SALT_KEY=NexusAI_Secure_Salt_2026

# Networking & Microservice Ports
PORT_STREAMLIT=8501
PORT_FASTAPI=8001
FASTAPI_HOST=0.0.0.0

# Database Storage Locations (SQLite)
DB_STORAGE_PATH=nexus_storage.db
DB_AUDIT_PATH=nexus_audit.db
DB_AUTH_PATH=nexus_auth.db

# Telemetry & Hardware Baselines
WATER_BASE_MEAN=3100.0
WATER_BASE_STD=75.0
ELEC_BASE_MEAN=2200.0
ELEC_BASE_STD=120.0
BASE_HUMIDITY=65.0
BASE_OUTDOOR_TEMP=32.0

# Buffer & System Configuration
MAX_BUFFER_SIZE=500
LOG_LEVEL=INFO
ENVIRONMENT=production
